# Copy to ignored .env and enter credentials locally.
# The Python catalog command uses: uv run --env-file .env
PREDICTEFY_API_KEY=

# Kalshi needs a key ID and a private-key file; never paste PEM contents here.
# The isolated reference application uses its own external env convention.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=.secrets/kalshi-private-key.pem
# production or demo; must match the account that issued the key.
KALSHI_ENVIRONMENT=
